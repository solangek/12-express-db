<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <title><%= title %></title>
  </head>
  <body>
  <script src="/javascripts/client.js"> </script>
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10">
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h1 class="card-title text-center mb-4 display-5 fw-bold"><%= title %></h1>
            <p class="text-muted text-center">Populate the database:</p>
            <form action="/action/add" method="post" class="mb-4">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">First Name</label>
                  <input class="form-control" type="text" name="firstName" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Last Name</label>
                  <input class="form-control" type="text" name="lastName" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Phone</label>
                  <input class="form-control" type="text" name="phone">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Email</label>
                  <input class="form-control" type="text" name="email">
                </div>
              </div>
              <div class="d-grid gap-2 mt-4">
                <button class="btn btn-success btn-lg" type="submit">Save to database</button>
              </div>
            </form>
            <div class="d-flex justify-content-between align-items-center mb-3">
              <button class="btn btn-primary btn-lg" id="getdata">Show all DB contents</button>
              <span class="text-muted">Data will be displayed below:</span>
            </div>
            <div id="data" class="mb-4">
              <!-- Bootstrap Table for DB contents -->
              <div id="db-table-container" style="display:none;">
                <div class="table-responsive">
                  <table class="table table-striped table-hover align-middle" id="db-table">
                    <thead class="table-dark">
                      <tr>
                        <th scope="col">#</th>
                        <th scope="col">First Name</th>
                        <th scope="col">Last Name</th>
                        <th scope="col">Phone</th>
                        <th scope="col">Email</th>
                        <th scope="col">Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <!-- Data rows will be injected by client.js -->
                    </tbody>
                  </table>
                </div>
              </div>
              <!-- Placeholder for empty state -->
              <div id="db-empty" class="alert alert-info text-center" style="display:none;">
                No contacts found in the database.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
