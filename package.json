{
  "name": "express-mariadb-contacts",
  "version": "1.0.0",
  "description": "Express.js application with MariaDB database using Sequelize ORM",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "express",
    "mariadb",
    "sequelize",
    "nodejs",
    "rest-api"
  ],
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "debug": "^4.3.4",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "http-errors": "^1.8.1",
    "mariadb": "^3.4.5",
    "morgan": "^1.10.0",
    "mysql2": "^3.3.2",
    "sequelize": "^6.32.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
